@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Campus Companion</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f4f7fe 0%, #e0e8ff 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }
        .brand-icon {
            font-size: 3rem;
            color: #4318FF;
            text-align: center;
            margin-bottom: 20px;
        }
        .btn-primary-custom {
            background: linear-gradient(135deg, #4318FF, #8D54FF);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px;
            font-weight: 600;
        }
        .btn-primary-custom:hover {
            box-shadow: 0 10px 20px rgba(67, 24, 255, 0.3);
            color: white;
        }
        .form-control {
            border-radius: 10px;
            padding: 12px 15px;
            background: #f8f9fc;
            border: 1px solid #e3e6f0;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #4318FF;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand-icon">
            <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <h3 class="text-center fw-bold mb-1" style="color: #2b3674;">Welcome Back</h3>
        <p class="text-center text-muted small mb-4">Please sign in to continue</p>

        @if (TempData["SuccessMessage"] != null)

        {
                <div class="alert alert-success py-2 small text-center rounded-3 fw-bold">
                    <i class="fa-solid fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                </div>
        }

        @if (ViewBag.Error != null)

        {
                <div class="alert alert-danger py-2 small text-center rounded-3 fw-bold">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Error
                </div>
        }

        <form method="post" action="/Login">
            <div class="mb-3">
                <label class="form-label small fw-bold text-muted">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="raghu@gmail.com" required>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-bold text-muted">Password</label>
                <input type="password" name="password" class="form-control" placeholder="raghu123" required>
            </div>
            <button type="submit" class="btn btn-primary-custom w-100">Sign In <i class="fa-solid fa-arrow-right ms-2"></i></button>
        </form>

        <div class="text-center mt-4">
            <div class="mb-2">
                <span class="text-muted small">Don't have an account?</span>
                <a href="/Login/Register" class="text-decoration-none small fw-bold" style="color: #4318FF;">Register</a>
            </div>
            <a href="/" class="text-decoration-none small" style="color: #4318FF;"><i class="fa-solid fa-arrow-left me-1"></i> Back to Home</a>
        </div>
    </div>
</body>
</html>
