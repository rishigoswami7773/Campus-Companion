@model TaskItem

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Add Task</h2>

<form method="post">

    <input asp-for="Title" class="form-control mb-2" placeholder="Task Title" />

    <input asp-for="DueDate" type="date" class="form-control mb-2" />

    <select asp-for="Priority" class="form-control mb-2">
        <option>High</option>
        <option>Medium</option>
        <option>Low</option>
    </select>

    <button class="btn btn-primary">Save</button>

</form>