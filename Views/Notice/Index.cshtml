@model IEnumerable<Campus_Companion.Models.NoticeModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Notice Management";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">Notice Management</h2>
        <a href="/Notice/Create" class="btn btn-primary shadow-sm"><i class="fa-solid fa-plus me-2"></i> Add Notice</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Published Date</th>
                    <th>Target Audience</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.PublishedDate.ToShortDateString()</td>
                            <td><span class="badge bg-info text-dark">@item.TargetAudience</span></td>
                            <td class="text-end">
                                <a href="/Notice/Edit/@item.Id" class="btn btn-sm btn-outline-primary shadow-sm me-1"><i class="fa-solid fa-pen"></i> Edit</a>
                                <a href="/Notice/Delete/@item.Id" class="btn btn-sm btn-outline-danger shadow-sm"><i class="fa-solid fa-trash"></i> Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No notices available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>