@model IEnumerable<NoticeItem>
@{
    ViewData["Title"] = "Notices";
}

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{
    var selectedCategory = Context.Request.Query["category"].ToString();
    var fromDate = Context.Request.Query["fromDate"].ToString();
    var toDate = Context.Request.Query["toDate"].ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Notices</h2>
    <a asp-action="Create" class="btn btn-primary">Add Notice</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="category" class="form-select">
            @if (string.IsNullOrWhiteSpace(selectedCategory))
            {
                <option value="" selected="selected">All Notices</option>
            }
            else
            {
                <option value="">All Notices</option>
            }

            @if (selectedCategory == "important")
            {
                <option value="important" selected="selected">Important</option>
            }
            else
            {
                <option value="important">Important</option>
            }

            @if (selectedCategory == "normal")
            {
                <option value="normal" selected="selected">Normal</option>
            }
            else
            {
                <option value="normal">Normal</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input name="fromDate" type="date" class="form-control" value="@fromDate" />
    </div>
    <div class="col-md-2">
        <input name="toDate" type="date" class="form-control" value="@toDate" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

<div class="row g-3">
    @foreach (var notice in Model)
    {
            var important = notice.Category.Contains("important", StringComparison.OrdinalIgnoreCase)
                || notice.Category.Contains("exam", StringComparison.OrdinalIgnoreCase)
                || notice.Category.Contains("urgent", StringComparison.OrdinalIgnoreCase);
            <div class="col-md-6">
            <div class="card card-3d card-3d-header card-notices p-3 h-100 @(important ? "notice-important" : "")">
                <div class="d-flex justify-content-between">
                    <h5>@notice.Title</h5>
                    <span class="badge bg-secondary">@notice.Category</span>
                </div>
                <p class="mb-1">@notice.Content</p>
                <small class="text-muted">@notice.Date.ToString("dd MMM yyyy")</small>
                <div class="d-flex gap-2 mt-2">
                    <a asp-action="Edit" asp-route-id="@notice.NoticeId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@notice.NoticeId" />
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>