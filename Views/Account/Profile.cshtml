@model Campus_Companion.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var profileImageUrl = ViewBag.ProfileImageUrl as string ?? "/img/default-avatar.svg";
    var studentId = Context.Session.GetInt32("StudentId");
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card card-3d p-4 h-100">
            <div class="d-flex align-items-center gap-3">
                <img src="@profileImageUrl" alt="Profile" style="width:86px; height:86px; border-radius:18px; object-fit:cover; box-shadow: 0 10px 22px rgba(79,70,229,0.18);" />
                <div>
                    <h4 class="mb-1">@Model.Name</h4>
                    <div class="text-muted">@Model.Email</div>
                </div>
            </div>

            <hr />

            <div class="alert alert-info mb-0">
                <b>Profile Tip:</b> Change name/email or upload new profile picture.
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card card-3d p-4">
            <h4 class="mb-3">Edit Profile</h4>

            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Profile Picture</label>
                    <input name="profileImage" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp,.gif,.bmp" />
                    <span class="text-danger">@Html.ValidationMessage("profileImage")</span>
                    <div class="text-muted small mt-1">Saved as: <b>uploads/profiles/student_@(studentId ?? 0).*</b></div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password (optional)</label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-3d">Save Changes</button>
                    <a href="/DashboardAdmin" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

