@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card card-3d card-3d-header p-4">
            <h3 class="mb-3">Reset Password</h3>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success mt-2">@ViewBag.Message</div>
            }

            <form method="post">
                <p class="text-muted small">Enter your registration email address and we will send you a secure link to reset your password.</p>
                <div class="mb-3 mt-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="Email" required class="form-control" placeholder="student@email.com" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
            </form>

            <a asp-action="Login" class="btn btn-link mt-3 text-center">Back to Login</a>
        </div>
    </div>
</div>
