@model Campus_Companion.Models.EventModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Event";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">Edit Event</h2>
        <a href="/EventAdmin" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <form method="post" action="/EventAdmin/Edit">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="mb-3">
            <label class="form-label">Event Name</label>
            <input type="text" name="Name" class="form-control" value="@Model.Name" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Event Date</label>
            <input type="date" name="EventDate" class="form-control" value="@Model.EventDate.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" name="Location" class="form-control" value="@Model.Location" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select" required>
                <option value="Upcoming" selected="@(Model.Status == "Upcoming")">Upcoming</option>
                <option value="Ongoing" selected="@(Model.Status == "Ongoing")">Ongoing</option>
                <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-2"></i> Update Event</button>
    </form>
</div>
