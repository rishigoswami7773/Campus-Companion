@model Campus_Companion.Models.EventModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Event";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">Add Event</h2>
        <a href="/EventAdmin" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <form method="post" action="/EventAdmin/Create">
        <div class="mb-3">
            <label class="form-label">Event Name</label>
            <input type="text" name="Name" class="form-control" required placeholder="Enter event name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Event Date</label>
            <input type="date" name="EventDate" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" name="Location" class="form-control" required placeholder="Enter location (e.g. Main Auditorium)" />
        </div>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-2"></i> Save Event</button>
    </form>
</div>