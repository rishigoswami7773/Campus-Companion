@model Campus_Companion.Models.FilterRule

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Filter Rule";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">Edit Filter Rule</h2>
        <a href="/FilterControl" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <form method="post" action="/FilterControl/Edit">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="mb-3">
            <label class="form-label">Rule Name</label>
            <input type="text" name="Name" class="form-control" value="@Model.Name" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="Category" class="form-select" required>
                <option value="Content" selected="@(Model.Category == "Content")">Content Filter</option>
                <option value="Security" selected="@(Model.Category == "Security")">Security Rule</option>
                <option value="Network" selected="@(Model.Category == "Network")">Network Policy</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select" required>
                <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-2"></i> Update Rule</button>
    </form>
</div>
