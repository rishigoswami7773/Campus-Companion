<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f5f6fa;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            background: #2f3640;
            color: white;
        }

            .sidebar a {
                color: white;
                display: block;
                padding: 12px;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background: #40739e;
                }
    </style>
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="sidebar p-3">
            <h4>Campus Admin</h4>

            <a href="/DashboardAdmin">Dashboard</a>
            <a href="/TaskAdmin">Tasks</a>
            <a href="/EventAdmin">Events</a>
            <a href="/NoticeAdmin">Notices</a>
            <a href="/UserAdmin">Users</a>
        </div>

        <!-- Content -->
        <div class="p-4 w-100">
            @RenderBody()
        </div>

    </div>

</body>
</html>