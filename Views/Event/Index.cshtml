@{
    Layout = null;
    bool isAdmin = Context.Request.Cookies["IsAdmin"] == "true";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Campus Companion - Events</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-color: #4318FF;
            --secondary-color: #8D54FF;
            --text-dark: #2b3674;
            --text-light: #a3aed1;
            --bg-light: #f4f7fe;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            padding-top: 100px;
        }

        /* Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
        }
        .navbar-brand {
            font-weight: 700;
            color: var(--primary-color) !important;
            font-size: 1.5rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 50px;
            animation: fadeIn 0.8s ease-in-out;
        }
        .page-header h1 {
            font-weight: 800;
            color: var(--text-dark);
        }

        .event-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: var(--transition);
            border: 1px solid rgba(0,0,0,0.02);
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .event-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(67, 24, 255, 0.1);
        }
        
        .event-img {
            height: 200px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 4rem;
        }
        .date-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: white;
            color: var(--primary-color);
            padding: 8px 15px;
            border-radius: 12px;
            font-weight: 700;
            text-align: center;
            line-height: 1.2;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .date-badge span {
            display: block;
            font-size: 0.8rem;
            color: var(--text-light);
            text-transform: uppercase;
        }

        .event-body {
            padding: 25px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .event-title {
            font-weight: 700;
            font-size: 1.25rem;
            margin-bottom: 15px;
            color: var(--text-dark);
        }
        .event-detail {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }
        .event-detail i {
            color: var(--primary-color);
            width: 15px;
        }
        
        .event-desc {
            margin-top: 15px;
            margin-bottom: 25px;
            font-size: 0.95rem;
            flex-grow: 1;
        }

        .btn-custom {
            padding: 10px 20px;
            border-radius: 50px;
            font-weight: 600;
            transition: var(--transition);
            width: 100%;
        }
        .btn-primary-custom {
            background: rgba(67, 24, 255, 0.1);
            color: var(--primary-color);
            border: none;
        }
        .btn-primary-custom:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
        }
        
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--primary-color);
            font-weight: 600;
            text-decoration: none;
            margin-bottom: 20px;
            transition: var(--transition);
        }
        .back-btn:hover {
            color: var(--secondary-color);
            transform: translateX(-5px);
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- Navbar Minimal -->
    <nav class="navbar navbar-expand-lg fixed-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <i class="fa-solid fa-graduation-cap"></i> Campus Companion
            </a>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a href="/" class="btn btn-outline-primary rounded-pill px-4 fw-bold">Home</a>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Home</a>
        
        <div class="page-header">
            <h1><i class="fa-solid fa-calendar-days text-primary"></i> Campus Events</h1>
            <p class="text-muted">Discover all college-related activities, seminars, and fests.</p>
        </div>

        <div class="row g-4">
            
            <!-- Event 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="event-card">
                    <div class="event-img">
                        <i class="fa-solid fa-laptop-code"></i>
                        <div class="date-badge">18<span>Nov</span></div>
                    </div>
                    <div class="event-body">
                        <h4 class="event-title">Tech Fest 2026: Innovate</h4>
                        <div class="event-detail"><i class="fa-solid fa-location-dot"></i> Main Auditorium</div>
                        <div class="event-detail"><i class="fa-regular fa-clock"></i> 9:00 AM - 5:00 PM</div>
                        <div class="event-desc">
                            The biggest technology festival of the year! Participate in hackathons, robotics competitions, and coding challenges. Win exciting prizes.
                        </div>
                        <button class="btn btn-custom btn-primary-custom">Register Now</button>
                    </div>
                </div>
            </div>

            <!-- Event 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="event-card">
                    <div class="event-img" style="background: linear-gradient(135deg, #05CD99, #04b386);">
                        <i class="fa-solid fa-briefcase"></i>
                        <div class="date-badge">25<span>Nov</span></div>
                    </div>
                    <div class="event-body">
                        <h4 class="event-title">Career Fair & Placement Drive</h4>
                        <div class="event-detail"><i class="fa-solid fa-location-dot"></i> Campus Ground</div>
                        <div class="event-detail"><i class="fa-regular fa-clock"></i> 10:00 AM - 4:00 PM</div>
                        <div class="event-desc">
                            Top MNCs are visiting the campus for recruitment. Bring multiple copies of your resume. Open to final year B.Tech, MCA, and BCA students.
                        </div>
                        <button class="btn btn-custom btn-primary-custom">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Event 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="event-card">
                    <div class="event-img" style="background: linear-gradient(135deg, #FF5B5B, #e34e4e);">
                        <i class="fa-solid fa-masks-theater"></i>
                        <div class="date-badge">05<span>Dec</span></div>
                    </div>
                    <div class="event-body">
                        <h4 class="event-title">Annual Cultural Fest</h4>
                        <div class="event-detail"><i class="fa-solid fa-location-dot"></i> Open Air Theater</div>
                        <div class="event-detail"><i class="fa-regular fa-clock"></i> 6:00 PM onwards</div>
                        <div class="event-desc">
                            Join us for an evening of music, dance, and drama. Showcasing the best talents across the campus. Food stalls will be available.
                        </div>
                        <button class="btn btn-custom btn-primary-custom">Get Passes</button>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
