@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{
    var pct = Math.Max(0, Math.Min(100, Model.CompletedPercentage));
    var pending = Math.Max(0, Model.TotalTasks - Model.CompletedTasks);
}

<h2 class="mb-4">Campus Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-3d card-3d-header card-tasks p-3 h-100">
            <h6>Total Tasks</h6>
            <h3>@Model.TotalTasks</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-3d card-3d-header card-completion p-3 h-100">
            <h6>Completed Tasks</h6>
            <h3>@Model.CompletedTasks</h3>
            <small class="text-muted">@pct.ToString("0.0")% done</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-3d card-3d-header card-schedule p-3 h-100">
            <h6>Pending Tasks</h6>
            <h3>@pending</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-3d card-3d-header card-notices p-3 h-100">
            <h6>Urgent Tasks</h6>
            <h3>@Model.UrgentTaskCount</h3>
        </div>
    </div>
</div>

@if (Model.UrgentTaskCount > 0)
{
    <div class="alert alert-warning mb-4" role="alert">
        <b>Reminder:</b> @Model.UrgentTaskCount urgent task(s) due in the next 2 days.
    </div>
}

@if (Model.DueTomorrowCount > 0)
{
    <div class="alert alert-info mb-4" role="alert">
        <b>Deadline Alert:</b> @Model.DueTomorrowCount task(s) due tomorrow.
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card card-3d p-3 h-100">
            <h5>Today's Schedule</h5>
            @if (!Model.TodaySchedule.Any()) { <p class="text-muted">No events today.</p> }
            else
            {
                <div class="timeline-list">
                @{
                    var idx = 0;
                }
                    @foreach (var item in Model.TodaySchedule)
                    {
                        var currentClass = idx == 0 ? "current" : "";
                        <div class="timeline-item @currentClass">@item.Time - @item.Title (@item.Location)</div>
                        idx++;
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-3d p-3 h-100">
            <h5>Upcoming Deadlines</h5>
            @if (!Model.UpcomingDeadlines.Any()) { <p class="text-muted">No pending deadlines.</p> }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var task in Model.UpcomingDeadlines)
                    {
                        var urgentCard = task.DueDate.Date <= DateTime.Today.AddDays(2) ? "urgent-card" : "";
                        <div class="card p-2 @urgentCard">
                            <div class="fw-semibold">@task.Title</div>
                            <small class="text-muted">@task.DueDate.ToString("dd MMM yyyy")</small>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-6">
        <div class="card card-3d p-3 h-100">
            <h5>Priority Tasks</h5>
            @{
                var pendingTotal = Model.PendingHighCount + Model.PendingMediumCount + Model.PendingLowCount;
                var denom = pendingTotal == 0 ? 1 : pendingTotal;
                var highW = (Model.PendingHighCount * 100.0) / denom;
                var medW = (Model.PendingMediumCount * 100.0) / denom;
                var lowW = (Model.PendingLowCount * 100.0) / denom;
            }
            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">High</small>
                    <small class="fw-semibold text-danger">@Model.PendingHighCount</small>
                </div>
                <div class="progress mb-2" style="height: 10px;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width:@highW.ToString("0")}%" aria-valuenow="@Model.PendingHighCount" aria-valuemin="0" aria-valuemax="@denom"></div>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">Medium</small>
                    <small class="fw-semibold" style="color:#f59e0b">@Model.PendingMediumCount</small>
                </div>
                <div class="progress mb-2" style="height: 10px;">
                    <div class="progress-bar" style="background:#f59e0b; width:@medW.ToString("0")}%" role="progressbar"
                         aria-valuenow="@Model.PendingMediumCount" aria-valuemin="0" aria-valuemax="@denom"></div>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">Low</small>
                    <small class="fw-semibold text-success">@Model.PendingLowCount</small>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width:@lowW.ToString("0")}%" aria-valuenow="@Model.PendingLowCount" aria-valuemin="0" aria-valuemax="@denom"></div>
                </div>
            </div>
            @if (!Model.PriorityTasks.Any()) { <p class="text-muted">No pending tasks.</p> }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var task in Model.PriorityTasks)
                    {
                        var prClass = task.Priority == Campus_Companion.Models.TaskPriority.High
                            ? "text-bg-danger"
                            : task.Priority == Campus_Companion.Models.TaskPriority.Medium ? "text-bg-warning"
                            : "text-bg-success";
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span>@task.Title</span>
                            <span class="d-flex align-items-center gap-2">
                                <span class="badge @prClass">@task.Priority</span>
                                <small class="text-muted">@task.DueDate.ToString("dd MMM yyyy")</small>
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card card-3d p-3 h-100">
            <h5>Important Notices</h5>
            @if (!Model.LatestNotices.Any()) { <p class="text-muted">No important notices.</p> }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var notice in Model.LatestNotices)
                    {
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between">
                                <b>@notice.Title</b>
                                <span class="badge bg-secondary">@notice.Category</span>
                            </div>
                            <div class="text-muted">@notice.Date.ToString("dd MMM yyyy")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-6">
        <div class="card card-3d card-3d-header p-3 h-100">
            <h5>Smart Suggestions</h5>
            <ul class="list-group list-group-flush mt-2">
                @foreach (var s in Model.SmartSuggestions)
                {
                    <li class="list-group-item px-0">🤖 @s</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card card-3d card-3d-header p-3 h-100">
            <h5>Sticky Notes</h5>
            <textarea id="stickyNoteBox" class="form-control" rows="6" placeholder="Write quick notes here..."></textarea>
            <small class="text-muted mt-2 d-block">Saved automatically on this browser.</small>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-12">
        <div class="card card-3d p-3 h-100">
            <h5>Upcoming Events (Next)</h5>
            @if (!Model.UpcomingSchedule.Any()) { <p class="text-muted">No upcoming events.</p> }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.UpcomingSchedule)
                    {
                        <li class="list-group-item px-0">@item.Date.ToString("dd MMM yyyy") • @item.Time - @item.Title (@item.Location)</li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var noteBox = document.getElementById("stickyNoteBox");
            if (noteBox) {
                noteBox.value = localStorage.getItem("sticky_note_main") || "";
                noteBox.addEventListener("input", function () {
                    localStorage.setItem("sticky_note_main", noteBox.value);
                });
            }

            var urgentCount = @Model.UrgentTaskCount;
            var tomorrowCount = @Model.DueTomorrowCount;
            if ((urgentCount > 0 || tomorrowCount > 0) && "Notification" in window) {
                if (Notification.permission === "granted") {
                    new Notification("Campus Companion Reminder", {
                        body: "Urgent: " + urgentCount + " | Due tomorrow: " + tomorrowCount
                    });
                } else if (Notification.permission !== "denied") {
                    Notification.requestPermission();
                }
            }
        })();
    </script>
}