@model IEnumerable<Campus_Companion.Models.TaskItem>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Super Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Overview</h2>
        <p class="text-muted mb-0">Welcome back, here's what's happening today.</p>
    </div>
    <div>
        <button class="btn btn-primary px-4 py-2 text-white shadow-sm" style="background: #4318FF; border: none; border-radius: 12px;">
            <i class="fa-solid fa-download me-2"></i> Export Report
        </button>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-4">

    <!-- Tasks Stat -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card d-flex align-items-center h-100">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem; color: #4318FF !important;">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div class="ms-3">
                <p class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Total Tasks</p>
                <h3 class="fw-bold mb-0">124</h3>
                <span class="text-success small fw-semibold"><i class="fa-solid fa-arrow-up"></i> +12%</span> <span class="text-muted small">from yesterday</span>
            </div>
        </div>
    </div>

    <!-- Events Stat -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card d-flex align-items-center h-100">
            <div class="stat-icon rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem; background: rgba(0, 181, 216, 0.1); color: #00B5D8;">
                <i class="fa-solid fa-calendar-days"></i>
            </div>
            <div class="ms-3">
                <p class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Upcoming Events</p>
                <h3 class="fw-bold mb-0">15</h3>
                <span class="text-success small fw-semibold"><i class="fa-solid fa-arrow-up"></i> +2%</span> <span class="text-muted small">this week</span>
            </div>
        </div>
    </div>

    <!-- Notices Stat -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card d-flex align-items-center h-100">
            <div class="stat-icon rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem; background: rgba(255, 178, 0, 0.1); color: #FFB200;">
                <i class="fa-solid fa-bullhorn"></i>
            </div>
            <div class="ms-3">
                <p class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Active Notices</p>
                <h3 class="fw-bold mb-0">8</h3>
                <span class="text-danger small fw-semibold"><i class="fa-solid fa-arrow-down"></i> -1%</span> <span class="text-muted small">newly read</span>
            </div>
        </div>
    </div>

    <!-- Users Stat -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card d-flex align-items-center h-100">
            <div class="stat-icon rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem; background: rgba(255, 91, 91, 0.1); color: #FF5B5B;">
                <i class="fa-solid fa-users-gear"></i>
            </div>
            <div class="ms-3">
                <p class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Total Users</p>
                <h3 class="fw-bold mb-0">2.4K</h3>
                <span class="text-success small fw-semibold"><i class="fa-solid fa-arrow-up"></i> +14</span> <span class="text-muted small">new users</span>
            </div>
        </div>
    </div>

</div>

<div class="row g-4 mb-4">
    <!-- Tasks Overview / Activity (dummy UI) -->
    <div class="col-lg-8">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Manage Tasks</h5>
                <div>
                    <a href="/TaskAdmin/Create" class="btn btn-sm btn-primary me-2"><i class="fa-solid fa-plus me-1"></i> Add Task</a>
                    <a href="/TaskAdmin/Index" class="text-decoration-none fw-semibold" style="color: #4318FF;">View All <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle">
                    <thead class="text-muted" style="border-bottom: 2px solid rgba(0,0,0,0.05);">
                        <tr>
                            <th class="ps-0 py-3">Task Title</th>
                            <th class="py-3">Priority</th>
                            <th class="py-3">Due Date</th>
                            <th class="text-end pe-0 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model != null)
                        {
                            foreach(var taskItem in Model)
                            {
                                <tr style="border-bottom: 1px solid rgba(0,0,0,0.02);">
                                    <td class="ps-0 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="fa-solid fa-list-check"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@taskItem.Title</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted">
                                        @if(taskItem.Priority == "High")
                                        {
                                            <span class="badge bg-danger">@taskItem.Priority</span>
                                        }
                                        else if (taskItem.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">@taskItem.Priority</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">@taskItem.Priority</span>
                                        }
                                    </td>
                                    <td class="py-3 text-muted">@taskItem.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-0 py-3">
                                        <a href="/TaskAdmin/Edit/@taskItem.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fa-solid fa-pen"></i> Edit</a>
                                        <a href="/TaskAdmin/Delete/@taskItem.Id" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i> Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No tasks available. Add some data!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="glass-card h-100">
            <h5 class="fw-bold mb-4">Quick Actions</h5>
            
            <a href="/TaskAdmin" class="text-decoration-none border rounded-4 p-3 d-flex align-items-center mb-3 transition hover-bg" style="border-color: rgba(0,0,0,0.05) !important;">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-dark">Add New Task</h6>
                    <small class="text-muted">Create a new task instantly</small>
                </div>
            </a>
            
            <a href="/EventAdmin" class="text-decoration-none border rounded-4 p-3 d-flex align-items-center mb-3" style="border-color: rgba(0,0,0,0.05) !important;">
                <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-calendar-plus"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-dark">Schedule Event</h6>
                    <small class="text-muted">Add a new campus event</small>
                </div>
            </a>
            
            <a href="/Notice" class="text-decoration-none border rounded-4 p-3 d-flex align-items-center mb-3" style="border-color: rgba(0,0,0,0.05) !important;">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-dark">Publish Notice</h6>
                    <small class="text-muted">Broadcast to all students</small>
                </div>
            </a>

            <div class="mt-4 p-3 rounded-4" style="background: linear-gradient(135deg, #4318FF 0%, #8664FF 100%); color: white;">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-circle-info fs-4 me-2 text-white"></i>
                    <h6 class="mb-0 fw-bold">System Status</h6>
                </div>
                <p class="mb-0 small" style="color: rgba(255,255,255,0.8);">All services are running smoothly. Database last backed up 3 hours ago.</p>
            </div>
            
        </div>
    </div>
</div>