@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Control";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">User Management</h2>
        <div>
            <a href="/UserAdmin/CreateStudent" class="btn btn-primary shadow-sm me-2"><i class="fa-solid fa-user-graduate me-2"></i> Add Student</a>
            <a href="/UserAdmin/CreateTeacher" class="btn btn-success shadow-sm"><i class="fa-solid fa-chalkboard-user me-2"></i> Add Teacher</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">R</div>
                            <div>
                                <h6 class="mb-0">Rishi</h6>
                                <small class="text-muted">Student</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge bg-info text-dark">Student</span></td>
                    <td>rishi@gmail.com</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td class="text-end">
                        <a href="/UserAdmin/Edit/1" class="btn btn-sm btn-outline-primary shadow-sm me-1"><i class="fa-solid fa-pen"></i> Edit</a>
                        <a href="/UserAdmin/Delete/1" class="btn btn-sm btn-outline-danger shadow-sm"><i class="fa-solid fa-trash"></i> Delete</a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-success text-white d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">H</div>
                            <div>
                                <h6 class="mb-0">Harsh</h6>
                                <small class="text-muted">Teacher</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge bg-warning text-dark">Teacher</span></td>
                    <td>harsh@gmail.com</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td class="text-end">
                        <a href="/UserAdmin/Edit/2" class="btn btn-sm btn-outline-primary shadow-sm me-1"><i class="fa-solid fa-pen"></i> Edit</a>
                        <a href="/UserAdmin/Delete/2" class="btn btn-sm btn-outline-danger shadow-sm"><i class="fa-solid fa-trash"></i> Delete</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>