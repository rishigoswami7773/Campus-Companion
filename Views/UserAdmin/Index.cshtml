@model IEnumerable<Campus_Companion.Models.AppUser>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Control";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">User Management</h2>
        <div>
            <a href="/UserAdmin/CreateStudent" class="btn btn-primary shadow-sm me-2"><i class="fa-solid fa-user-graduate me-2"></i> Add Student</a>
            <a href="/UserAdmin/CreateTeacher" class="btn btn-success shadow-sm"><i class="fa-solid fa-chalkboard-user me-2"></i> Add Teacher</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle @(user.Role == "Teacher" ? "bg-success" : "bg-primary") text-white d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">@(user.Name.Substring(0, 1).ToUpper())</div>
                                    <div>
                                        <h6 class="mb-0">@user.Name</h6>
                                        <small class="text-muted">@user.Role</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge @(user.Role == "Teacher" ? "bg-warning" : "bg-info") text-dark">@user.Role</span></td>
                            <td>@user.Email</td>
                            <td><span class="badge @(user.Status == "Active" ? "bg-success" : "bg-secondary")">@user.Status</span></td>
                            <td class="text-end">
                                <a href="/UserAdmin/Edit/@user.Id" class="btn btn-sm btn-outline-primary shadow-sm me-1"><i class="fa-solid fa-pen"></i> Edit</a>
                                <a href="/UserAdmin/Delete/@user.Id" class="btn btn-sm btn-outline-danger shadow-sm"><i class="fa-solid fa-trash"></i> Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No users available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>