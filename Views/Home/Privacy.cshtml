@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>System Settings</h2>
    <button class="btn btn-primary px-4">Save Changes</button>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card card-3d p-4 h-100">
            <h5 class="mb-4">Notification Preferences</h5>
            
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="pushNotif" checked>
                <label class="form-check-label ms-2" for="pushNotif"><strong>Push Notifications</strong><br>
                <small class="text-muted">Receive browser notifications for upcoming tasks and events.</small></label>
            </div>
            
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="emailAlert">
                <label class="form-check-label ms-2" for="emailAlert"><strong>Email Alerts</strong><br>
                <small class="text-muted">Get daily summaries of your schedule to your registered email.</small></label>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="urgentOnly">
                <label class="form-check-label ms-2" for="urgentOnly"><strong>Urgent Only Mode</strong><br>
                <small class="text-muted">Mute all notifications except for tasks due in less than 24 hours.</small></label>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card card-3d p-4 h-100">
            <h5 class="mb-4">Appearance</h5>
            
            <div class="mb-4">
                <label class="form-label fw-semibold">Dashboard Theme</label>
                <select class="form-select">
                    <option value="system" selected>System Default</option>
                    <option value="light">Light Theme</option>
                    <option value="dark">Dark Theme</option>
                </select>
            </div>

            <div>
                <label class="form-label fw-semibold">Card Animation Intensity</label>
                <input type="range" class="form-range" min="0" max="100" step="10" value="50">
                <div class="d-flex justify-content-between text-muted small">
                    <span>Static</span>
                    <span>High 3D Movement</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card card-3d card-3d-header p-4">
            <h5 class="mb-4">Account Privacy</h5>
            
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" value="" id="profileVis" checked>
                <label class="form-check-label" for="profileVis">
                    Make Profile Visible to Classmates
                </label>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" value="" id="shareProgress">
                <label class="form-check-label" for="shareProgress">
                    Share completion progress on campus leaderboards
                </label>
            </div>

            <div class="d-flex gap-3 border-top pt-4">
                <button class="btn btn-outline-danger">Request Data Archive</button>
                <button class="btn btn-outline-secondary">Clear Cache Data</button>
            </div>
        </div>
    </div>
</div>
